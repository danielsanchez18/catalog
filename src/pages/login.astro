---
import Auth from '../layouts/Auth.astro';
import LoginForm from '@/components/auth/LoginForm';

export const prerender = false;
---

<Auth>
	<div class="h-full flex flex-col items-center justify-center gap-y-10 py-20 px-5">

        <div class="flex flex-col items-center justify-center">
            <img src="/favicon.svg" alt="Logo" class="invert w-14 h-14" />
            <h1 class="text-3xl font-medium font-display uppercase text-center mt-5">Iniciar sesión</h1>
            <p class="text-center text-neutral-800 mt-1">Bienvenido de vuelta. Ingresa tus credenciales</p>
        </div>

        <div class="w-full max-w-xs">
            <LoginForm client:load />
        </div>

    </div>
</Auth>
