---
import { Button } from '@/components/ui/button';
import { createElement } from 'react';
import { ArrowLeft } from 'lucide-react';
---

<div class="flex flex-col gap-y-3">
    <Button
        variant="link"
        className="p-0 w-fit"
        render={createElement('a', { href: '/dashboard/team' })}
    >
        <ArrowLeft className="size-4" />
        Volver al equipo
    </Button>

    <div class="space-y-1">
        <h1 class="text-lg font-medium font-sans">Agregar miembro</h1>
        <p class="text-sm text-neutral-800">Crea un usuario para que pueda iniciar sesión y gestionar el catálogo.</p>
    </div>
</div>