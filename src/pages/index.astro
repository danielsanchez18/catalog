---
import Layout from '../layouts/Layout.astro';
import Navbar from '@/components/Navbar.astro';
import Hero from '@/sections/home/Hero.astro';
import Services from '@/sections/home/Services.astro';
import Products from '@/sections/home/Products.astro';
import Footer from '@/components/Footer.astro';
---

<Layout>
	<div class="fixed top-0 left-0 w-full z-50">
		<Navbar />
	</div>
	<main class="mt-21 min-h-dvh">
		<div class="mt-5">
			<Hero />
		</div>
		<div class="mx-auto max-w-4xl px-5 py-20 space-y-20">
			<Services />
			<Products />
		</div>
	</main>
	<Footer />
</Layout>
