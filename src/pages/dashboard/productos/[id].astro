---
import Header from '@/components/dashboard/Header.astro';
import Navlink from '@/components/dashboard/Navlink.astro';
import Dashboard from '@/layouts/Dashboard.astro';
import Breadcrumb from '@/components/dashboard/Breadcrumb';
import Detail from '@/sections/dashboard/productos/Detail.astro';
import { getProducts } from '@/lib/products';

export function getStaticPaths() {
    return getProducts().map((product) => ({
        params: { id: product.id },
        props: { product },
    }));
}

const { product } = Astro.props;
---

<Dashboard>
    <Header />
    <div class="max-md:hidden">
        <Navlink />
    </div>
    <div class="md:hidden">
        <Breadcrumb current={product.nombre} client:load />
    </div>

    <div class="w-full max-w-7xl mx-auto px-5 py-7 space-y-10">
        <Detail product={product} />
    </div>
</Dashboard>
