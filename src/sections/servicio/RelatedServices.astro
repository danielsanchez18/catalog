---
import ServiceCard from '@/components/ServiceCard.astro';
import type { Service } from '@/lib/types';

interface Props {
  currentService: Service;
  services: Service[];
}

const { currentService, services } = Astro.props;

const related = services
  .filter((s) => s.id !== currentService.id)
  .slice(0, 3);
---

<section class="w-full space-y-10 border-t border-border pt-10">

    <div class="space-y-1">
        <p class="text-sm">También te puede interesar</p>
        <h2 class="text-2xl font-display uppercase font-medium">Servicios relacionados</h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-2 gap-3">
        {related.map((service) => (
            <ServiceCard service={service} />
        ))}
    </div>

</section>
