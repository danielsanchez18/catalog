---
import { Button } from '@/components/ui/button';
import { createElement } from 'react';
import type { Service } from '@/lib/types';

interface Props {
  service: Service;
}

const { service } = Astro.props;

const detailLink = createElement('a', { href: `/servicio/${service.id}` });
---

<div class="border border-border rounded-lg p-3 group hover:bg-accent transition text-start">
    
    <div class="relative overflow-hidden rounded-md bg-accent h-60">
        <img 
            src={service.imagen_url}
            alt={service.nombre}
            class="absolute top-0 left-0 w-full h-full z-10 group-hover:scale-105 transition duration-300" />
        <p class="absolute top-3 left-3 rounded-full w-fit bg-white px-3 py-1 text-xs font-mono font-medium z-20">Tag</p>
    </div>

    <div class="flex flex-col gap-y-1 px-1 py-2 mt-2">
        <h3 class="font-medium line-clamp-2 font-sans">{service.nombre}</h3>
        <p class="text-sm text-neutral-800 line-clamp-3">{service.descripcion}</p>
        <Button
            className="rounded-full mt-2 self-start w-full"
            render={detailLink}
        >
            Ver más
        </Button>
    </div>
</div>
