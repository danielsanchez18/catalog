---
import { Button } from '@/components/ui/button';
import { ArrowLeft, Tag } from 'lucide-react';
import { createElement } from 'react';
import type { Service } from '@/lib/types';

interface Props {
  service: Service;
}

const { service } = Astro.props;

const backLink = createElement('a', { href: '/servicios' });

const formatPrice = (price: number) =>
  price.toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
---

<Button
  variant="link"
  className="w-fit p-0"
  render={backLink}
>
  <ArrowLeft className="size-4" />
  Volver a servicios
</Button>

<article class="grid sm:grid-cols-2 gap-8">
  <div class="relative overflow-hidden rounded-lg bg-accent h-80 sm:h-full min-h-64">
    <img
      src={service.imagen_url}
      alt={service.nombre}
      class="absolute inset-0 w-full h-full object-cover"
    />
    <p class="absolute top-3 left-3 rounded-full w-fit bg-white px-3 py-1 text-xs font-mono font-medium z-10">
      <Tag className="inline size-3 mr-1" />
      Publicado
    </p>
  </div>

  <div class="flex flex-col gap-y-4 py-2">
    <div class="space-y-1">
      <p class="text-sm text-muted-foreground">Detalle del servicio</p>
      <h1 class="text-3xl font-heading tracking-tighter font-medium">{service.nombre}</h1>
    </div>

    <p class="text-neutral-800 text-sm leading-relaxed">
      {service.descripcion}
    </p>

    <div class="border-t border-border pt-4">
      <p class="text-sm text-muted-foreground mb-1">Precio base desde</p>
      <p class="text-2xl font-mono font-medium">{formatPrice(service.precio_minimo)}</p>
    </div>

    <Button className="rounded-full w-fit px-6 mt-2">
      Cotizar
    </Button>

    <p class="text-xs text-muted-foreground mt-auto">
      Publicado el {new Date(service.created_at).toLocaleDateString('es-MX', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </p>
  </div>
</article>
