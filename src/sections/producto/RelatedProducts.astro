---
import ProductCard from '@/components/ProductCard';
import type { Product } from '@/lib/types';

interface Props {
  currentProduct: Product;
  products: Product[];
}

const { currentProduct, products } = Astro.props;

const related = products
  .filter((p) => p.id !== currentProduct.id)
  .slice(0, 3);
---

<section class="w-full space-y-10 border-t border-border pt-10">

    <div class="space-y-1">
        <p class="text-sm">También te puede interesar</p>
        <h2 class="text-2xl font-display uppercase font-medium">Productos relacionados</h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {related.map((product) => (
            <ProductCard product={product} />
        ))}
    </div>

</section>
