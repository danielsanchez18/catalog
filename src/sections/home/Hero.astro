---
import { Button } from "@/components/ui/button";
---

<section class="mx-auto max-w-4xl">
    <div class="w-full overflow-hidden px-5 py-10 md:py-16 flex flex-col gap-6 text-start">

        <p class="text-xs rounded-full px-3 py-1.5 bg-white border backdrop-blur-xl w-fit font-medium font-mono">Productos / Servicios variados</p>

        <h1 class="font-display uppercase font-medium text-4xl md:text-6xl tracking-tight leading-none">
            Catálogo de productos seleccionados
        </h1>

        <p class="text-muted-foreground text-sm md:text-base">
            Cada artículo incluye su descripción y precio. Explora el catálogo y escribe por el que te interese.
        </p>

        <div class="flex flex-wrap items-center w-full justify-start gap-1 pt-2">
            <a href="#productos" class="rounded-full">
                <Button
                    variant="default"
                    className="px-3 rounded-full"
                >
                    Ver el catálogo
                </Button>
            </a>
            <a href="#productos" class="rounded-full">
                <Button
                    variant="outline"
                    className="px-3 rounded-full"
                >
                    Reservar un servicio
                </Button>
            </a>
        </div>

    </div>
</section>
