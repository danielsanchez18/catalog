---
import Header from '@/components/dashboard/Header.astro';
import Navlink from '@/components/dashboard/Navlink.astro';
import Dashboard from '@/layouts/Dashboard.astro';
import Breadcrumb from '@/components/dashboard/Breadcrumb';
import Detail from '@/sections/dashboard/team/Detail.astro';
import { getTeamMemberById } from '@/lib/db/team';

export const prerender = false;

const { id } = Astro.params;

const member = await getTeamMemberById(id!);
if (!member) {
    return Astro.redirect('/dashboard/team');
}
---

<Dashboard>
    <Header />
    <div class="max-md:hidden">
        <Navlink />
    </div>
    <div class="md:hidden">
        <Breadcrumb current={member.full_name ?? member.email} client:load />
    </div>

    <div class="w-full max-w-7xl mx-auto px-5 py-7 space-y-10">
        <Detail member={member} />
    </div>
</Dashboard>