---
import { Button } from '@/components/ui/button';
import { Gem, Pencil, SoapDispenserDroplet, Star } from 'lucide-react';
---

<section class="flex items-center gap-x-2 overflow-hidden">
    <Button
        variant="outline"
        className="px-3 rounded-full">
        Todo
    </Button>
    <Button
        variant="outline"
        className="px-3 rounded-full">
        <Pencil />
        Papelería
    </Button>
    <Button
        variant="outline"
        className="px-3 rounded-full">
        <Gem />
        Bisutería
    </Button>
    <Button
        variant="outline"
        className="px-3 rounded-full">
        <SoapDispenserDroplet />
        Cuidado Personal
    </Button>
</section>