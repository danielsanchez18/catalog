---
import Header from '@/components/dashboard/Header.astro';
import Navlink from '@/components/dashboard/Navlink.astro';
import Dashboard from '@/layouts/Dashboard.astro';
import Greeting from '@/sections/dashboard/overview/Greeting.astro';
import StatsCards from '@/components/dashboard/overview/StatsCards';
import RecentProducts from '@/components/dashboard/overview/RecentProducts';
import Breadcrumb from '@/components/dashboard/Breadcrumb';
import { getProfileName } from '@/lib/db/dashboard';

export const prerender = false;

const name = await getProfileName(Astro.cookies);
---

<Dashboard>
    <Header />
    <div class="max-md:hidden">
        <Navlink />
    </div>
    <div class="md:hidden">
        <Breadcrumb current="Overview" client:load />
    </div>

    <div class="w-full max-w-7xl mx-auto px-5 py-7 flex flex-col gap-10">
        <Greeting name={name} />
        <StatsCards client:load />
        <RecentProducts client:load />
    </div>
</Dashboard>