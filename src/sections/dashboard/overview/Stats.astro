---
import { Package, CheckCircle2, FileText } from 'lucide-react';
import type { DashboardStats } from '@/lib/db/dashboard';

interface Props {
    stats: DashboardStats;
}

const { stats } = Astro.props;

const cards = [
    {
        label: 'Productos totales',
        value: stats.totalProductos,
        icon: Package,
    },
    {
        label: 'Publicados',
        value: stats.publicados,
        icon: CheckCircle2,
    },
    {
        label: 'En borrador',
        value: stats.borradores,
        icon: FileText,
    },
];
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
        cards.map((card) => (
            <div class="flex items-center justify-between gap-x-4 rounded-xl border border-border p-5">
                <div class="space-y-1">
                    <p class="text-sm text-muted-foreground">{card.label}</p>
                    <p class="text-2xl font-mono font-medium">{card.value}</p>
                </div>
                <card.icon className="size-5 text-muted-foreground" />
            </div>
        ))
    }
</div>