---
import { Button } from '@/components/ui/button';
import { createElement } from 'react';
import { ArrowLeft, CalendarDays, Mail, UserRound } from 'lucide-react';
import TeamActions from '@/components/dashboard/team/TeamActions';
import type { TeamMember } from '@/lib/types';

interface Props {
    member: TeamMember;
}

const { member } = Astro.props as Props;

const formatDate = (date: string) =>
    new Date(date).toLocaleDateString('es-MX', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
    });
---

<div class="flex flex-col gap-y-5">
    <Button
        variant="link"
        className="w-fit p-0"
        render={createElement('a', { href: '/dashboard/team' })}
    >
        <ArrowLeft className="size-4" />
        Volver al equipo
    </Button>

    <article class="grid gap-6 lg:grid-cols-2">
        <div class="flex flex-col items-center justify-center gap-y-3 rounded-xl border border-border bg-muted/40 p-8 text-center">
            <div class="flex size-20 items-center justify-center rounded-full bg-primary/10 text-primary">
                <UserRound className="size-10" />
            </div>
            <div class="space-y-1">
                <h1 class="text-2xl tracking-tight font-medium font-sans">{member.full_name ?? 'Sin nombre'}</h1>
                <p class="text-sm text-muted-foreground">{member.email}</p>
            </div>
        </div>

        <div class="space-y-5">
            <div class="space-y-1">
                <p class="text-sm text-muted-foreground">Detalle del miembro</p>
            </div>

            <dl class="grid grid-cols-2 gap-x-5 gap-y-4">
                <div>
                    <dt class="text-sm text-muted-foreground">Correo</dt>
                    <dd class="inline-flex items-center gap-x-1 text-sm font-medium">
                        <Mail className="size-3.5" />
                        {member.email}
                    </dd>
                </div>
                <div>
                    <dt class="text-sm text-muted-foreground">Acceso</dt>
                    <dd class="text-sm font-medium">Catálogo compartido</dd>
                </div>
            </dl>

            <div class="border-t border-border pt-4 space-y-4">
                <div class="flex items-center gap-x-3 text-sm text-muted-foreground">
                    <span class="inline-flex items-center gap-x-1">
                        <CalendarDays className="size-3.5" />
                        Se unió el {formatDate(member.created_at)}
                    </span>
                </div>
            </div>
        </div>
    </article>
</div>

<TeamActions member={member} client:load />