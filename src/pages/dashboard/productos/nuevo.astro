---
import Header from '@/components/dashboard/Header.astro';
import Navlink from '@/components/dashboard/Navlink.astro';
import Dashboard from '@/layouts/Dashboard.astro';
import Breadcrumb from '@/components/dashboard/Breadcrumb';
import Title from '@/sections/dashboard/productos/NuevoTitle.astro';
import ProductForm from '@/components/dashboard/product/ProductForm';
---

<Dashboard>
    <Header />
    <div class="max-md:hidden">
        <Navlink />
    </div>
    <div class="md:hidden">
        <Breadcrumb current="Agregar producto" client:load />
    </div>

    <div class="w-full max-w-7xl mx-auto px-5 py-7 space-y-10">
        <Title />
        <!-- <div class="max-w-3xl">
        </div> -->
        <ProductForm client:load />
    </div>
</Dashboard>